{
  "installCommand": "npm --prefix \"frontend 3\" install",
  "buildCommand": "npm --prefix \"frontend 3\" run build",
  "outputDirectory": "frontend 3/dist",
  "build": {
    "env": {
      "VITE_CHAIN_ID": "0x38",
      "VITE_NBT_TOKEN": "0x3A911a15CB705f616d705D44297360C5C0BC1a48",
      "VITE_STAKING_BANK": "0xDD51846755476bd6Cb02fACc28cA40c62F2Eb28d",
      "VITE_NBT_PAIR": "",
      "VITE_FEE_TOKEN": "",
      "VITE_ATTACK_VAULT": "0x0Ef15A34b264f77acA743d96baEC6BF5ffDdbDa9",
      "VITE_USDT": "0x55d398326f99059fF775485246999027B3197955"
    }
  },
  "functions": {
    "api/staking.js": { "maxDuration": 10 },
    "api/rpc.js": { "maxDuration": 10 }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
